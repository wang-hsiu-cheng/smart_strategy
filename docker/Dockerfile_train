# =========================
# Builder: compile wheels
# =========================
FROM nvidia/cuda:12.2.0-devel-ubuntu22.04 AS builder

LABEL org.opencontainers.image.authors="wang.tw.ted@gmail.com"
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Taipei

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-dev \
    python3-tk \
    build-essential \
    swig \
    cmake \
    curl \
    libglew-dev \
    libx11-dev \
    libxrender-dev \
    libxext-dev \
    libxau-dev \
    libxdmcp-dev \
    libosmesa6-dev \
    libglfw3-dev \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --upgrade pip wheel setuptools

# ---- build wheels only ----
RUN pip wheel --no-cache-dir --wheel-dir=/wheels \
    gymnasium[classic_control,box2d,mujoco] \
    stable-baselines3 \
    tensorboard \
    shimmy \
    numpy \
    matplotlib

# =========================
# Runtime: minimal execution
# =========================
FROM nvidia/cuda:12.2.0-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ARG USERNAME=ted

RUN apt-get update && apt-get install -y --no-install-recommends \
    sudo \
    gosu \
    vim \
    curl \
    libgl1 \
    libglib2.0-0 \
    libosmesa6 \
    libgl1-mesa-glx \
    libglfw3 \
    && rm -rf /var/lib/apt/lists/*

# ---- PyTorch GPU ----
RUN pip install --no-cache-dir \
    torch --index-url https://download.pytorch.org/whl/cu122

# ---- install prebuilt wheels ----
COPY --from=builder /wheels /wheels
RUN pip install --no-cache-dir /wheels/*

WORKDIR /home/$USERNAME
ENV TZ=Asia/Taipei
ENV SHELL=/bin/bash
ENV TERM=xterm-256color

USER $USERNAME
CMD ["/bin/bash", "-ic"]
